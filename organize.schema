# organize.schema -- repository layout
# Last updated: 2026-07-07

bin/                 # POSIX ssh shim.
lib/                 # Shared client/config compatibility modules.
examples/            # Sanitized config snippets for reuse on other machines.
ssh_totp.py          # Core wrapper and SOCKS relay.
totp_askpass.py      # TOTP askpass helper.
sshotp               # POSIX launcher.
sshotp.cmd           # Windows launcher.
install.sh           # POSIX installer.
install.ps1          # Windows PowerShell installer.
test_ssh_totp_regression.py  # Regression tests.

